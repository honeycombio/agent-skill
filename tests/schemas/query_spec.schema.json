{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Honeycomb Query Spec",
  "description": "Schema for run_query query_spec parameter. Validates structure found in plugin skill examples.",
  "type": "object",
  "properties": {
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "COUNT", "CONCURRENCY", "SUM", "AVG", "COUNT_DISTINCT",
              "MAX", "MIN", "P001", "P01", "P05", "P10", "P20", "P25",
              "P50", "P75", "P80", "P90", "P95", "P99", "P999",
              "HEATMAP", "RATE_SUM", "RATE_AVG", "RATE_MAX"
            ]
          },
          "column": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["op"],
        "additionalProperties": false
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "enum": [
              "=", "!=", ">", ">=", "<", "<=",
              "starts-with", "does-not-start-with",
              "ends-with", "does-not-end-with",
              "exists", "does-not-exist",
              "contains", "does-not-contain",
              "in-result", "join-result",
              "in", "not-in", "search"
            ]
          },
          "value": {},
          "join_column": {
            "type": "string"
          }
        },
        "required": ["column", "op"]
      }
    },
    "breakdowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "COUNT", "CONCURRENCY", "SUM", "AVG", "COUNT_DISTINCT",
              "MAX", "MIN", "P001", "P01", "P05", "P10", "P20", "P25",
              "P50", "P75", "P80", "P90", "P95", "P99", "P999",
              "HEATMAP", "RATE_SUM", "RATE_AVG", "RATE_MAX"
            ]
          },
          "order": {
            "type": "string",
            "enum": ["ascending", "descending"]
          }
        }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "calculated_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "expression"]
      }
    },
    "time_range": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "start_time": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "end_time": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "granularity": {
      "type": "integer",
      "enum": [1, 5, 10, 15, 30, 60, 120, 300, 600, 900, 1800, 3600, 7200, 10800, 14400, 21600, 43200, 86400, 172800, 259200, 604800]
    }
  },
  "required": ["calculations"]
}
